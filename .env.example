# Required
TELEGRAM_BOT_TOKEN=
ANTHROPIC_API_KEY=
DATABASE_URL=postgresql+psycopg://lars:lars@localhost:5433/lars
ALLOWLIST_TELEGRAM_IDS=        # comma-separated Telegram user IDs, e.g. 111111111,222222222

# Optional (defaults shown)
ANTHROPIC_MODEL=claude-sonnet-4-6
DEFAULT_GENERATION_LOCAL_TIME=20:00
DEFAULT_TIMEZONE=America/New_York
DEFAULT_UNIT_SYSTEM=imperial
LOG_LEVEL=INFO
